# Copy to .env for local development. On Render, set these in the dashboard.

# Supabase > Project Settings > Database > Connection string > "Session pooler" (port 5432).
# Replace the scheme with postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://postgres.YOURREF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# "supabase" in production; "local" stores files on disk (Batch API unavailable).
STORAGE_BACKEND=supabase
SUPABASE_URL=https://YOURREF.supabase.co
# Supabase > Project Settings > API > service_role key. Server-side only, never expose it.
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=recordings

# app.gnani.ai > API keys
GNANI_API_KEY=
# console.groq.com > API keys
GROQ_API_KEY=
# Tried in order; the first model your Groq account can use wins.
GROQ_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b,llama-3.1-8b-instant

# Limits
MAX_UPLOAD_MB=50
MAX_DURATION_MIN=180

# true: the API process also runs the queue worker (free hosting).
# false: run `python -m app.worker` separately.
RUN_WORKER_IN_PROCESS=true
SECRET_KEY=change-me
